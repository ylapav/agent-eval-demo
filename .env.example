# ── Tietokanta ────────────────────────────────────────────────────────
# Jätä tyhjäksi tai poista rivi kokonaan: silloin käytetään PGliteä eli
# paikallista Postgresia pgvectorilla, hakemistossa .data/pg. Ei Dockeria,
# ei pilvitiliä. Vercel-ajossa tähän tulee Neonin URL.
# DATABASE_URL=postgresql://user:pass@host.neon.tech/db?sslmode=require

# ── Mallit ────────────────────────────────────────────────────────────
# Avain haetaan Anthropic Consolesta. Arvo jätetään tähän tiedostoon
# tyhjäksi tarkoituksella: näin `git grep` avainkuviolla palauttaa tyhjän,
# ja jokainen osuma on aito löydös eikä paikanpitäjä. Kohinaa tuottava
# salaisuusskannaus opettaa sivuuttamaan skannauksen.
ANTHROPIC_API_KEY=

# Agentin malli. Oletus on claude-opus-5.
MODEL_ID=claude-opus-5

# Ajattelun syvyys: low | medium | high | xhigh | max.
# medium on chat-käytössä latenssin ja laadun järkevä piste.
EFFORT=medium

# Arvioijan on oltava eri malli kuin agentin: sama malli palkitsisi
# omaa tyyliään. Halvempi riittää, koska tehtävä on kyllä/ei per väite.
JUDGE_MODEL=claude-haiku-4-5

# ── Upotukset ─────────────────────────────────────────────────────────
# Ilman tätä katkelmat indeksoidaan ilman upotuksia ja haku käyttää
# leksikaalista polkua (Postgresin tekstihaku, suomen stemmer). Vektorihaku ei
# toimi lainkaan ilman avainta, koska KYSELYN upotus vaatii API-kutsun joka
# kerta — esilasketut upotukset kattavat vain katkelmat.
# `npm run eval` kieltäytyy ajamasta leksikaalisella polulla.
VOYAGE_API_KEY=

# ── Pääsy ─────────────────────────────────────────────────────────────
# Vain paikalliseen webhook-ajoon. Päätepistettä /api/agent ei julkaista:
# julkinen jaettu salaisuus on yhden vuodon päässä siitä, että kuka tahansa
# ajaa mallia laskuun. Katso README, "Mitä ei ole toteutettu".
AGENT_WEBHOOK_SECRET=vaihda-tama
ADMIN_PASSWORD=vaihda-tama
