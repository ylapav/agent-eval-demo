# ── Tietokanta ────────────────────────────────────────────────────────
# Jätä tyhjäksi tai poista rivi kokonaan: silloin käytetään PGliteä eli
# paikallista Postgresia pgvectorilla, hakemistossa .data/pg. Ei Dockeria,
# ei pilvitiliä. Vercel-ajossa tähän tulee Neonin URL.
# DATABASE_URL=postgresql://user:pass@host.neon.tech/db?sslmode=require

# ── Anthropic: agentti ────────────────────────────────────────────────
# Avain haetaan Anthropic Consolesta. Arvo jätetään tähän tiedostoon
# tyhjäksi tarkoituksella: näin `git grep` avainkuviolla palauttaa tyhjän,
# ja jokainen osuma on aito löydös eikä paikanpitäjä. Kohinaa tuottava
# salaisuusskannaus opettaa sivuuttamaan skannauksen.
#
# HUOM: tämä on MALLI. Oikeat avaimet kuuluvat tiedostoon .env.local,
# joka on .gitignoressa. Tähän tiedostoon kirjoitettu avain päätyy
# versionhallintaan.
ANTHROPIC_API_KEY=

# Agentin malli.
MODEL_ID=claude-haiku-4-5-20251001

# Ajattelun syvyys: low | medium | high | xhigh | max.
# Haiku 4.5 ei tue effort-parametria; lib/agent/models.ts jättää sen pois.
EFFORT=medium

# ── OpenAI: upotukset ja arvioija ─────────────────────────────────────
# Sama avain kattaa molemmat. Ilman sitä katkelmat indeksoidaan ilman
# upotuksia ja haku käyttää leksikaalista polkua (Postgresin tekstihaku,
# suomen stemmer). Vektorihaku ei toimi lainkaan ilman avainta, koska
# KYSELYN upotus vaatii API-kutsun joka kerta — esilasketut upotukset
# kattavat vain katkelmat. `npm run eval` kieltäytyy leksikaalisella polulla.
OPENAI_API_KEY=

# Arvioijan on oltava eri TOIMITTAJA kuin agentin. Saman perheen malli
# jakaa koulutusdatan ja tyylitaipumukset agentin kanssa ja palkitsee juuri
# niitä muotoiluja joita agentti tuottaa. Ajaja kieltäytyy, jos toimittaja
# on sama. Perustelu ja sen rajat: README, "Arvioijan riippumattomuus".
JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-5-nano

# ── Pääsy ─────────────────────────────────────────────────────────────
# Vain paikalliseen webhook-ajoon. Päätepistettä /api/agent ei julkaista:
# julkinen jaettu salaisuus on yhden vuodon päässä siitä, että kuka tahansa
# ajaa mallia laskuun. Katso README, "Mitä ei ole toteutettu".
AGENT_WEBHOOK_SECRET=vaihda-tama
ADMIN_PASSWORD=vaihda-tama
