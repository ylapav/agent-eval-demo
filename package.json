{
  "name": "nordkanta-agent",
  "private": true,
  "description": "Suomenkielinen asiakaspalveluagentti: RAG, työkalukutsut, webhook ja evaluointikerros lukituilla kynnyksillä.",
  "keywords": [
    "ai-agent",
    "rag",
    "llm-evaluation",
    "anthropic",
    "typescript",
    "nextjs",
    "pglite"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/guards.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-products.ts",
    "index": "tsx lib/rag/index-content.ts",
    "setup": "npm run db:push && npm run db:seed && npm run index",
    "eval": "tsx lib/eval/run.ts",
    "calibrate": "tsx scripts/calibrate-floor.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@neondatabase/serverless": "^1.1.0",
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.3",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
